1(DEFINE (EVAL EXP ENV FENV)
	(COND ((ATOM EXP)
	       (COND ((NUMBERP EXP) EXP)
		     (T (VALUE EXP ENV))))
	      ((EQ (CAR EXP) 'QUOTE)
	       (CADR EXP))
	      ((EQ (CAR EXP) 'LAMBDA)
	       (LIST '&PROCEDURE (CADR EXP) (CADDR EXP) ENV))
	      ((EQ (CAR EXP) 'FLAMBDA)
	       (LIST '&FLUNARG (CADR EXP) (CADDR EXP) ENV))
	      ((EQ (CAR EXP) 'COND)
	       (EVCOND (CDR EXP) ENV))
	      ((EQ (CAR EXP) 'FLUID)
	       (VALUE (CADR EXP) FENV))
	      (T (APPLY (EVAL (CAR EXP) ENV)
			(THUNKLIS (CDR EXP) ENV)
			FENV))))
